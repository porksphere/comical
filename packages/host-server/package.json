{
  "name": "@comical/host-server",
  "version": "0.0.0",
  "type": "module",
  "description": "HTTP server host: exposes the bridge runtime as a REST API for browser and app clients",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./router": "./src/router.ts",
    "./bridge-provider": "./src/bridge-provider.ts",
    "./registry-provider": "./src/registry-provider.ts",
    "./tracker-provider": "./src/tracker-provider.ts",
    "./bridge-manager": "./src/bridge-manager.ts",
    "./tracker-manager": "./src/tracker-manager.ts",
    "./settings-store": "./src/settings-store.ts",
    "./library-store": "./src/library-store.ts",
    "./downloads-store": "./src/downloads-store.ts",
    "./blob-store": "./src/blob-store.ts",
    "./page-fetcher": "./src/page-fetcher.ts",
    "./sync-host": "./src/sync-host.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --hot src/server.ts"
  },
  "dependencies": {
    "@comical/contract": "workspace:*",
    "@comical/core": "workspace:*",
    "@comical/downloads": "workspace:*",
    "@comical/host-bun": "workspace:*",
    "@comical/library": "workspace:*",
    "@comical/registry": "workspace:*",
    "@comical/runtime": "workspace:*",
    "@comical/sync": "workspace:*",
    "hono": "^4.12.23"
  }
}
